# --- App ---
SECRET_KEY=change-this-to-a-long-random-string
ENVIRONMENT=development
# Informational flag only (surfaced on GET /api/v1/system/status) — it does
# not change backend behavior. The pipeline always runs the real adapters
# below; it only drops to a heuristic when a model/weights file is missing.
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg2://depthwizard:depthwizard@db:5432/depthwizard

# --- Storage ---
STORAGE_ROOT=./storage

# --- Models ---
# dav2 = Depth Anything V2 (primary model for the GeoDepth-3D upgrade, see
# README). Falls back automatically to midas if transformers/torch or the
# model weights aren't available in this environment — see
# app/ml/adapters/segmentation_adapter.py::get_adapter.
DEPTH_MODEL_ADAPTER=dav2
# dav2 | im2height | midas
IM2HEIGHT_WEIGHTS_PATH=
MIDAS_MODEL_TYPE=DPT_Hybrid
SEGMENTATION_WEIGHTS_PATH=./storage/weights/unet_resnet18.pt

# --- Disaster-management thresholds ---
COLLAPSE_RADIUS_FACTOR=0.6
CRATER_MIN_DEPTH_M=1.0
CRATER_MIN_CIRCULARITY=0.65
ALERT_FLOOD_SUBMERGED_PCT=30
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_AUTHORITY_EMAIL=

# --- Free APIs ---
HF_API_TOKEN=
HF_CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta
HF_TRANSLATE_MODEL_PREFIX=Helsinki-NLP/opus-mt-en-

# --- SRTM ---
OPENTOPOGRAPHY_API_KEY=

# --- Bhashini (Government of India, MeitY) - voice input ASR ---
# Free credentials: sign up at https://bhashini.gov.in, then request ULCA API
# access from your profile page (approval is usually quick for individuals/students).
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_ASR_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_SOURCE_LANGUAGE=hi

# --- data.gov.in (Open Government Data Platform India) ---
# Free key: sign up at https://data.gov.in -> your profile page.
# Resource ID: browse data.gov.in for a dataset whose page shows a live
# "API" button (not "Request API" - many datasets are file-only), open it,
# and copy the Resource ID shown there. Disaster/rainfall/flood datasets fit
# this project best.
OPENDATA_GOV_IN_API_KEY=
OPENDATA_GOV_IN_RESOURCE_ID=
OPENDATA_GOV_IN_LABEL=
