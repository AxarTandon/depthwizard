# Depthwizard — frontend environment variables
# Copy to .env.local and fill in.
#
# This project ships wired to the real FastAPI backend by default
# (NEXT_PUBLIC_USE_BACKEND=true below). Only flip it to "false" if you
# specifically want the old no-backend demo-data fallback (e.g. to preview
# the UI with nothing running).
#
# IMPORTANT (Docker): these NEXT_PUBLIC_* values are baked into the client
# bundle at `next build` time. If you change them, rebuild the frontend
# image (`docker compose build frontend`) — a container restart alone will
# not pick up the new value.

# Base URL of the FastAPI backend, including /api/v1
# Local dev:  http://localhost:8000/api/v1
# Deployed:   https://<your-render-service>.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# true = call the real backend at NEXT_PUBLIC_API_BASE_URL.
# false = fall back to generated demo data with no backend running.
NEXT_PUBLIC_USE_BACKEND=true
